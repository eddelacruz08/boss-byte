# Optional overrides for docker-compose.yml. Docker Compose reads a root `.env`
# automatically; copy this file to `.env` only if you need to change something.
# (Application settings live in apps/api/.env and apps/core/.env instead.)

# ─── Host ports ───────────────────────────────────────────────────────────────
# Change these when a port is already taken on your machine. If you move a
# backing service, point apps/api/.env at the new port as well — `npm run setup`
# does this for you when it creates apps/api/.env.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# PGADMIN_PORT=5050

# Only used by `docker compose --profile app` (the production images).
# API_PORT=4000
# CORE_PORT=8080

# ─── Images ───────────────────────────────────────────────────────────────────
# MinIO no longer publishes its server and client images to Docker Hub, so the
# stack defaults to Chainguard's builds. Any image with the same `minio` / `mc`
# entrypoints, a shell and `mc` on the path can be swapped in here.
# MINIO_IMAGE=cgr.dev/chainguard/minio:latest-dev
# MINIO_MC_IMAGE=cgr.dev/chainguard/minio-client:latest-dev
