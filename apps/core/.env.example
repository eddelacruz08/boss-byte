# `npm run setup` copies this file to .env. Every value is optional in development.

# Base URL of the API as the browser sees it. The default is same-origin, which
# the Vite dev server (and nginx in production) proxies to the API.
VITE_API_URL=/api/v1

# Where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000

# Google sign-in (optional). The button only appears when all four are set,
# and the API must be configured with the matching Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
