# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
APP_NAME=BossByte
# Public URL of the dashboard. Used for CORS, WebAuthn origin checks and email links.
APP_URL=http://localhost:5173
# Comma-separated list of extra origins allowed by CORS (APP_URL is always allowed).
CORS_ORIGINS=
# Number of reverse proxies in front of the API (Cloud Run, Nginx): 0 locally, 1 behind one proxy.
TRUST_PROXY=0

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://bossbyte:bossbyte@localhost:5432/bossbyte
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ─── Redis (cache, rate limits, WebAuthn challenges, Bull queues) ─────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
# `npm run setup` generates a key pair into apps/api/keys/.
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
# In hosted environments pass the PEMs base64-encoded instead of mounting files.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=bossbyte-api
JWT_AUDIENCE=bossbyte

# ─── Cookies and CSRF ─────────────────────────────────────────────────────────
# At least 32 characters. `npm run setup` fills these in.
CSRF_SECRET=
# SameSite for auth cookies: lax (default), strict, or none (dashboard on a different site; needs HTTPS).
COOKIE_SAME_SITE=lax

# ─── Rate limits ──────────────────────────────────────────────────────────────
# Leave empty for the defaults in @bossbyte/shared: 300 requests a minute per
# address, and 20 per 15 minutes on the endpoints that accept credentials.
RATE_LIMIT_GLOBAL_MAX=
RATE_LIMIT_AUTH_MAX=

# ─── AES-256-GCM column encryption ────────────────────────────────────────────
# Base64-encoded 32-byte keys. `npm run setup` fills these in.
DATA_ENCRYPTION_KEY=
# Comma-separated retired keys, kept only so old rows can still be decrypted.
DATA_ENCRYPTION_PREVIOUS_KEYS=
# HMAC key for blind indexes (exact-match lookups on encrypted columns).
BLIND_INDEX_KEY=

# ─── WebAuthn passkeys ────────────────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=BossByte

# ─── File storage: "s3" (AWS S3, MinIO) or "gcs" (Google Cloud Storage) ───────
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
# Only if browsers must reach the bucket at a different address than the API does (signed URLs).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=bossbyte
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
GCS_BUCKET=
GCS_PROJECT_ID=

# ─── Email (Mailpit locally) ──────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="BossByte <no-reply@bossbyte.local>"

# ─── Firebase Admin (optional — leave empty to disable Firebase sign-in) ──────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences; they are converted to newlines at startup.
FIREBASE_PRIVATE_KEY=

# ─── Background worker ────────────────────────────────────────────────────────
# Jobs processed in parallel per queue.
WORKER_CONCURRENCY=5
# Set to expose GET /health from the worker (platforms that require a listening port).
WORKER_HEALTH_PORT=
