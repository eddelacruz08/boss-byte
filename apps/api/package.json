{
  "name": "@bossbyte/api",
  "version": "0.1.0",
  "private": true,
  "description": "BossByte backend API \u2014 Express 5, PostgreSQL (Drizzle ORM), Redis and Bull.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsdown",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:rotate-keys": "tsx src/db/rotate-keys.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.int.config.ts",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@bossbyte/shared": "*",
    "@google-cloud/storage": "^9.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.1.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "fast-csv": "^5.0.8",
    "file-type": "^22.3.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "ml-matrix": "^6.15.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "otpauth": "^9.6.0",
    "pdfkit": "^0.21.0",
    "pdfmake": "^0.3.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.2",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
