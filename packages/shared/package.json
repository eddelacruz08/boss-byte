{
  "name": "@bossbyte/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas, TypeScript types, constants and pure helpers shared by the BossByte API and dashboard.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .turbo coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  }
}
